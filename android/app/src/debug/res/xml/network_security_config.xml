<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. Allows plaintext HTTP so the app can reach the Firebase
  Emulator Suite, which serves plain HTTP, during integration tests. This file
  lives under src/debug so it is never included in a release build, where
  cleartext stays blocked.

  base-config permits cleartext everywhere because a physical test device
  reaches the emulators on an arbitrary LAN IP that cannot be listed ahead of
  time. This is acceptable only because the file never ships in release.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
