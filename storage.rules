rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // The signed-in user's profile (users/{uid}), read from Firestore.
    function profile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    // A deactivated account keeps a valid sign-in token for a while, so
    // every role check also looks at `isActive` (missing counts as active).
    function isActiveUser() {
      return request.auth != null && profile().get('isActive', true) != false;
    }

    // True if the signed-in user's profile says they are the HQ admin.
    function isAdmin() {
      return isActiveUser() && profile().role == 'storeAdmin';
    }

    // True for a Delivery Driver that HQ assigned this order to.
    function isDriverOf(orderId) {
      return isActiveUser()
        && profile().role == 'storeWorker'
        && profile().get('workerRole', null) == 'deliveryDriver'
        && firestore.get(/databases/(default)/documents/orders/$(orderId))
            .data.get('driverId', null) == request.auth.uid;
    }

    // Product photos: products/{productId}/{fileName}. Any signed-in user
    // may read them (the customer app shows them by download URL); only the
    // admin uploads or removes them, and only images of a sensible size.
    match /products/{productId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    // Delivery proof photos: orders/{orderId}/proof.jpg. The admin reviews
    // them and the order's own driver sees theirs; only that driver uploads
    // one, and only an image of a sensible size.
    match /orders/{orderId}/{fileName} {
      allow read: if isAdmin() || isDriverOf(orderId);
      allow create, update: if isDriverOf(orderId)
        && fileName == 'proof.jpg'
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Everything else is closed.
  }
}
