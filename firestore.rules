rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // True if the signed-in user's profile says they are the HQ admin.
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
            .data.role == 'storeAdmin';
    }

    // User profiles. The document id is the Firebase Authentication uid.
    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      // Users read their own profile. The admin reads all (Staff tab).
      allow read: if isOwner() || isAdmin();

      // Public sign-up can only create customers, and only with these fields.
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'role', 'createdAt'])
        && request.resource.data.role == 'customer'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;

      // The admin creates Store Worker profiles from the Staff tab.
      allow create: if isAdmin()
        && request.resource.data.role == 'storeWorker'
        && request.resource.data.workerRole in ['packingStaff', 'deliveryDriver']
        && request.resource.data.isActive == true;

      // Users can edit their details, but never their own role, email,
      // creation time, branch or active flag.
      allow update: if isOwner()
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role', 'email', 'createdAt', 'workerRole', 'branchId',
                     'isActive', 'joinedAt']);

      // The admin edits workers (details, role, branch, active), but not
      // their login email, and cannot turn them into another kind of user.
      allow update: if isAdmin()
        && resource.data.role == 'storeWorker'
        && request.resource.data.role == 'storeWorker'
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['email', 'createdAt', 'joinedAt']);

      allow delete: if false;
    }

    // Catalogue read access for the customer app.
    //
    // Products and categories are shared across branches; a branch's
    // inventory (price, stock) lives under branches/{branchId}/inventory.
    // Any signed-in user may read the catalogue. Writes are not allowed
    // from the client yet; the Store Admin side will write through a
    // privileged path (Cloud Functions or admin SDK) once connected.
    function isSignedIn() {
      return request.auth != null;
    }

    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Store branches. Every signed-in user can see them (customers choose
    // a branch, workers see theirs). Only the admin adds or edits them.
    // Branches are never deleted; they are closed instead.
    match /branches/{branchId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if false;

      match /inventory/{productId} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    // Customer orders (the shared order contract). The customer app writes
    // an order at checkout and reads its own orders for tracking; the Store
    // Worker and Store Admin apps read them to pack and oversee.
    //
    // A signed-in staff member (not a customer) can read any order. The id
    // of the staff role check is kept here rather than inferred, so a
    // customer can never read another customer's order.
    function isStaff() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
            .data.role in ['storeAdmin', 'storeWorker'];
    }

    match /orders/{orderId} {
      function isOrderOwner() {
        return request.auth != null
          && resource.data.customerId == request.auth.uid;
      }

      // Owner reads their own order; staff read any order.
      allow read: if isOrderOwner() || isStaff();

      // A customer creates their own order. The order must belong to them,
      // start in a pending state, and carry the required fields, so a
      // client cannot forge an order into packing or onto another account.
      allow create: if request.auth != null
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasAll(
            ['number', 'customerId', 'branchId', 'items', 'total', 'status',
             'placedAt'])
        && request.resource.data.placedAt == request.time;

      // Staff advance an order's status (pack, ready, deliver, complete).
      // The customer side does not update orders yet; cancellation comes
      // with its own rule in a later slice.
      allow update: if isStaff();

      allow delete: if false;
    }
  }
}
