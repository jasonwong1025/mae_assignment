rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // The signed-in user's own profile (users/{uid}). One document read per
    // request: Firestore caches repeated reads of the same path.
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // True for a signed-in user whose account has not been deactivated. A
    // deactivated Store Worker keeps a valid sign-in token until it expires,
    // so every staff check below also looks at `isActive` (missing counts as
    // active: customers and the admin have no such field).
    function isActiveUser() {
      return request.auth != null && profile().get('isActive', true) != false;
    }

    // True if the signed-in user's profile says they are the HQ admin.
    function isAdmin() {
      return isActiveUser() && profile().role == 'storeAdmin';
    }

    // Store Workers are exactly one of two kinds (users/{uid}.workerRole).
    // A packer works at one branch (users/{uid}.branchId); a driver is not
    // tied to a branch and is limited by which orders are assigned to them.
    function isPacker() {
      return isActiveUser()
        && profile().role == 'storeWorker'
        && profile().get('workerRole', null) == 'packingStaff';
    }

    function isDriver() {
      return isActiveUser()
        && profile().role == 'storeWorker'
        && profile().get('workerRole', null) == 'deliveryDriver';
    }

    // User profiles. The document id is the Firebase Authentication uid.
    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      // Users read their own profile. The admin reads all (Staff tab).
      allow read: if isOwner() || isAdmin();

      // Public sign-up can only create customers, and only with these fields.
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'role', 'createdAt'])
        && request.resource.data.role == 'customer'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;

      // Users can edit their details, but never their own role, email,
      // creation time, branch or active flag.
      allow update: if isOwner()
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role', 'email', 'createdAt', 'workerRole', 'branchId',
                     'isActive', 'joinedAt']);

      // The admin edits worker details and assignment, but not
      // their login email, and cannot turn them into another kind of user.
      allow update: if isAdmin()
        && resource.data.role == 'storeWorker'
        && request.resource.data.role == 'storeWorker'
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['email', 'createdAt', 'joinedAt', 'isActive']);

      allow delete: if false;

      // A customer's saved delivery addresses. Private to the owner: nobody
      // else, not even the admin, reads or writes them.
      match /addresses/{addressId} {
        allow read, write: if isOwner();
      }

      // A customer's grocery list: a single document, private to the owner.
      // Each item is a name, a quantity and, once the customer picks one, a
      // product id; the match with the catalogue is worked out in the app.
      match /groceryList/{docId} {
        allow read, delete: if isOwner();
        allow create, update: if isOwner()
          && docId == 'current'
          && request.resource.data.keys().hasOnly(['items', 'updatedAt'])
          && request.resource.data.keys().hasAll(['items', 'updatedAt'])
          && request.resource.data.items is list
          && request.resource.data.items.size() <= 100
          && request.resource.data.updatedAt == request.time;
      }

      // A customer's saved cart: a single document, private to the owner.
      // Holds only product ids and quantities; prices and stock are read
      // from the catalogue when the cart is loaded.
      match /cart/{docId} {
        allow read, delete: if isOwner();
        allow create, update: if isOwner()
          && docId == 'current'
          && request.resource.data.keys()
              .hasOnly(['lines', 'fulfilment', 'promoCode', 'updatedAt'])
          && request.resource.data.keys()
              .hasAll(['lines', 'fulfilment', 'updatedAt'])
          && request.resource.data.lines is list
          && request.resource.data.lines.size() <= 100
          && request.resource.data.fulfilment in ['delivery', 'pickup']
          && request.resource.data.updatedAt == request.time;
      }
    }

    // Catalogue read access for the customer app.
    //
    // Products and categories are shared across branches; a branch's
    // inventory (price, stock) lives under branches/{branchId}/inventory.
    // Any signed-in user may read the catalogue. Only the admin writes it
    // (the Inventory tab), with the shape checked here; nothing is ever
    // deleted from the client (hide a product at a branch instead).
    function isSignedIn() {
      return request.auth != null;
    }

    // A product document as the Inventory tab saves it.
    function validProduct(data) {
      return data.keys().hasOnly(
          ['name', 'brand', 'categoryId', 'packSize', 'description',
           'imageUrls', 'lowStockLevel'])
        && data.keys().hasAll(['name', 'categoryId'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.categoryId is string
        && (!('imageUrls' in data)
            || (data.imageUrls is list && data.imageUrls.size() <= 5))
        && (!('lowStockLevel' in data)
            || (data.lowStockLevel is int && data.lowStockLevel >= 0));
    }

    match /products/{productId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && validProduct(request.resource.data);
      allow delete: if false;
    }

    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'sortOrder'])
        && request.resource.data.keys().hasAll(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && (!('sortOrder' in request.resource.data)
            || request.resource.data.sortOrder is int);
      allow delete: if false;
    }

    // Store branches. Every signed-in user can see them (customers choose
    // a branch, workers see theirs). Only the admin adds or edits them.
    // Branches are never deleted; they are closed instead.
    match /branches/{branchId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if false;

      // Price and stock of a product at this branch; the document id is the
      // product id. Only the admin writes it.
      match /inventory/{productId} {
        allow read: if isSignedIn();
        allow create, update: if isAdmin()
          && request.resource.data.keys().hasOnly(['price', 'stock', 'isHidden'])
          && request.resource.data.keys().hasAll(['price', 'stock', 'isHidden'])
          && request.resource.data.price is number
          && request.resource.data.price >= 0
          && request.resource.data.stock is int
          && request.resource.data.stock >= 0
          && request.resource.data.isHidden is bool;
        allow delete: if false;
      }
    }

    // Customer orders (the shared order contract). The checkout Function
    // creates an order and the customer reads its own orders for tracking; Store
    // Admin oversees every order; a Store Worker sees and changes only the
    // orders their job gives them (see below).
    //
    // WorkerOrderPolicy in the Flutter app describes the same limits for the
    // buttons on screen. These rules are the real boundary: they are checked
    // on the server whatever a modified client sends.
    match /orders/{orderId} {
      function isOrderOwner() {
        return request.auth != null
          && resource.data.customerId == request.auth.uid;
      }

      // The fields the customer app writes at checkout. Nobody changes
      // them afterwards.
      function checkoutKeys() {
        return ['number', 'customerId', 'customerName', 'customerPhone',
                'branchId', 'branchName', 'branchAddress', 'isDelivery',
                'address', 'addressLocation', 'customerNote', 'items',
                'promoCode', 'subtotal', 'deliveryFee', 'discount', 'total',
                'placedAt'];
      }

      // Fields Store Admin may change: who the order is assigned to, and
      // when it is due.
      function assignmentKeys() {
        return ['dueAt', 'packerId', 'packerName', 'packerAssignedAt',
                'driverId', 'driverName', 'driverAssignedAt'];
      }

      function changedKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      // Every time written by staff comes from the server clock, never from
      // a phone. A time that changes must equal request.time.
      function serverTime(field) {
        return !(field in changedKeys())
          || request.resource.data[field] == request.time;
      }

      function workflowTimesAreServerTimes() {
        return serverTime('statusSince')
          && serverTime('packingStartedAt')
          && serverTime('readyAt')
          && serverTime('collectionVerifiedAt')
          && serverTime('outForDeliveryAt')
          && serverTime('completedAt');
      }

      // A status change, so `statusSince` must change with it.
      function movesStatus(from, to) {
        return resource.data.status == from
          && request.resource.data.status == to
          && changedKeys().hasAll(['status', 'statusSince']);
      }

      function validVerification(method) {
        return method in ['qr', 'manual'];
      }

      // A packer working on this order: it is at their branch and HQ
      // assigned it to them.
      function packerOwns() {
        return isPacker()
          && resource.data.branchId == profile().branchId
          && resource.data.get('packerId', null) == request.auth.uid;
      }

      // A driver delivering this order: HQ assigned it to them.
      function driverOwns() {
        return isDriver()
          && resource.data.isDelivery == true
          && resource.data.get('driverId', null) == request.auth.uid;
      }

      // Shortages: an item the packer found unavailable. `shortages` maps a
      // line id to its entry and every write changes exactly one entry. The
      // writer also sets `shortageLineId` to that line id, so the rules know
      // which entry to check (rules cannot loop over a map).
      function shortageId() {
        return request.resource.data.shortageLineId;
      }

      function shortagesBefore() {
        return resource.data.get('shortages', {});
      }

      function oneShortageChanged() {
        return shortageId() is string
          && request.resource.data.shortages
              .diff(shortagesBefore()).affectedKeys()
              .hasOnly([shortageId()]);
      }

      function shortageAfter() {
        return request.resource.data.shortages[shortageId()];
      }

      // A replacement is shaped like an order line with the same line id.
      function validReplacement(replacement) {
        return replacement is map
          && replacement.keys().hasOnly(
              ['lineId', 'productId', 'name', 'brand', 'packSize', 'quantity',
               'unitPrice', 'categoryId', 'category', 'description',
               'imageUrl'])
          && replacement.keys().hasAll(
              ['lineId', 'productId', 'name', 'quantity', 'unitPrice'])
          && replacement.lineId == shortageId()
          && replacement.name is string
          && replacement.quantity is int
          && replacement.quantity >= 1
          && replacement.quantity <= 99
          && replacement.unitPrice is number
          && replacement.unitPrice >= 0;
      }

      // Read: the owner; the admin (every order); a packer (their branch's
      // orders, so they can find a pickup or a bag for a driver); a driver
      // (only deliveries assigned to them). The apps ask for exactly these
      // (`branchId ==` or `driverId ==`), and Firestore checks a query
      // against this rule before running it.
      allow read: if isOrderOwner()
        || isAdmin()
        || (isPacker() && resource.data.branchId == profile().branchId)
        || (isDriver() && resource.data.get('driverId', null) == request.auth.uid);

      // The callable Function alone creates priced orders with Admin SDK.
      allow create: if false;

      // Store Admin assigns packers and drivers and sets the due time. It
      // cannot touch the checkout fields (customer, items, money) or the
      // worker's fulfilment fields.
      //
      // The only status the admin sets is `cancelled`, for an order that is
      // not finished (for example one waiting too long for the customer to
      // answer a replacement).
      allow update: if isAdmin()
        && changedKeys().hasOnly(assignmentKeys())
        && serverTime('statusSince')
        && serverTime('packerAssignedAt')
        && serverTime('driverAssignedAt');

      // Packing Staff: pending -> packing (start), ticking items while
      // packing, packing -> ready once every line is ticked. Only the
      // assigned packer, at the order's branch.
      allow update: if packerOwns()
        && movesStatus('pending', 'packing')
        && changedKeys().hasOnly(['status', 'statusSince', 'packingStartedAt'])
        && changedKeys().hasAll(['packingStartedAt'])
        && workflowTimesAreServerTimes();

      allow update: if packerOwns()
        && resource.data.status == 'packing'
        && changedKeys().hasOnly(['packedLineIds'])
        && request.resource.data.packedLineIds is list
        && request.resource.data.packedLineIds.size()
            <= resource.data.items.size();

      // Lines the customer removed (or the packer found no replacement for)
      // are listed with the packed ones when marking ready, so every line is
      // accounted for. An item still waiting for the customer's answer blocks
      // it.
      allow update: if packerOwns()
        && movesStatus('packing', 'ready')
        && changedKeys().hasOnly(
            ['status', 'statusSince', 'readyAt', 'readyBy', 'packedLineIds'])
        && changedKeys().hasAll(['readyAt', 'readyBy'])
        && request.resource.data.readyBy == request.auth.uid
        && request.resource.data.get('packedLineIds', []).size()
            == resource.data.items.size()
        && resource.data.get('openShortages', 0) == 0
        && workflowTimesAreServerTimes();

      // The packer finds an item unavailable while packing: with a
      // replacement for the customer to accept, or (none exists) removing
      // the line outright. A line that is already ticked, or already has a
      // shortage, cannot be flagged.
      allow update: if packerOwns()
        && resource.data.status == 'packing'
        && changedKeys().hasOnly(
            ['shortages', 'shortageLineId', 'openShortages'])
        && changedKeys().hasAll(['shortages'])
        && oneShortageChanged()
        && !(shortageId() in shortagesBefore())
        && !(shortageId() in resource.data.get('packedLineIds', []))
        && shortageAfter().flaggedAt == request.time
        && shortageAfter().status == 'proposed'
        && shortageAfter().keys().hasOnly(['status', 'replacement', 'flaggedAt'])
        && shortageAfter().keys().hasAll(['status', 'replacement', 'flaggedAt'])
        && validReplacement(shortageAfter().replacement)
        && request.resource.data.get('openShortages', 0)
            == resource.data.get('openShortages', 0) + 1;

      allow update: if packerOwns()
        && resource.data.status == 'packing'
        && changedKeys().hasOnly(['shortages', 'shortageLineId'])
        && changedKeys().hasAll(['shortages'])
        && oneShortageChanged()
        && !(shortageId() in shortagesBefore())
        && !(shortageId() in resource.data.get('packedLineIds', []))
        && shortageAfter().flaggedAt == request.time
        && shortageAfter().status == 'removed'
        && shortageAfter().keys().hasOnly(['status', 'flaggedAt'])
        && shortageAfter().keys().hasAll(['status', 'flaggedAt']);

      // Self-pickup handover: any active packer at the branch hands over a
      // ready pickup order, whoever packed it.
      allow update: if isPacker()
        && resource.data.branchId == profile().branchId
        && resource.data.isDelivery == false
        && movesStatus('ready', 'completed')
        && changedKeys().hasOnly(
            ['status', 'statusSince', 'pickupVerification',
             'pickupCompletedBy', 'pickupCompletedByName', 'completedAt'])
        && changedKeys().hasAll(
            ['pickupVerification', 'pickupCompletedBy', 'completedAt'])
        && validVerification(request.resource.data.pickupVerification)
        && request.resource.data.pickupCompletedBy == request.auth.uid
        && workflowTimesAreServerTimes();

      // Delivery Drivers, on the orders assigned to them: check the bag
      // (still ready), start the delivery once it has been checked by this
      // driver, and complete it with a proof photo.
      allow update: if driverOwns()
        && resource.data.status == 'ready'
        && changedKeys().hasOnly(
            ['collectionVerification', 'collectionVerifiedBy',
             'collectionVerifiedAt'])
        && changedKeys().hasAll(['collectionVerifiedBy', 'collectionVerifiedAt'])
        && validVerification(request.resource.data.collectionVerification)
        && request.resource.data.collectionVerifiedBy == request.auth.uid
        && workflowTimesAreServerTimes();

      allow update: if driverOwns()
        && movesStatus('ready', 'outForDelivery')
        && resource.data.get('collectionVerifiedBy', null) == request.auth.uid
        && changedKeys().hasOnly(['status', 'statusSince', 'outForDeliveryAt'])
        && changedKeys().hasAll(['outForDeliveryAt'])
        && workflowTimesAreServerTimes();

      allow update: if driverOwns()
        && movesStatus('outForDelivery', 'completed')
        && changedKeys().hasOnly(
            ['status', 'statusSince', 'deliveredBy', 'deliveredByName',
             'proofPhotoUrl', 'completedAt'])
        && changedKeys().hasAll(
            ['deliveredBy', 'proofPhotoUrl', 'completedAt'])
        && request.resource.data.deliveredBy == request.auth.uid
        && request.resource.data.proofPhotoUrl is string
        && request.resource.data.proofPhotoUrl.size() > 0
        && workflowTimesAreServerTimes();

      // While the order is out for delivery its driver reports where they
      // are, so the customer (who owns the order) can see the delivery
      // coming and an arrival time. Only the position and its server time
      // change.
      allow update: if driverOwns()
        && resource.data.status == 'outForDelivery'
        && changedKeys().hasOnly(['driverPosition', 'driverPositionAt'])
        // A stationary heartbeat keeps the same position; only its time
        // changes. Still require a server timestamp on every report.
        && changedKeys().hasAll(['driverPositionAt'])
        && request.resource.data.driverPosition is latlng
        && request.resource.data.driverPositionAt == request.time;
      // The customer answers a replacement while the order is being packed:
      // accept it or remove the item. Only the answer and its server time
      // change; the packer's proposal stays as it was.
      allow update: if isOrderOwner()
        && resource.data.status == 'packing'
        && changedKeys().hasOnly(
            ['shortages', 'shortageLineId', 'openShortages'])
        && changedKeys().hasAll(['shortages', 'openShortages'])
        && oneShortageChanged()
        && shortagesBefore()[shortageId()].status == 'proposed'
        && shortageAfter().status in ['accepted', 'removed']
        && shortageAfter().keys().hasOnly(
            ['status', 'replacement', 'flaggedAt', 'decidedAt'])
        && shortageAfter().keys().hasAll(
            ['status', 'replacement', 'flaggedAt', 'decidedAt'])
        && shortageAfter().replacement == shortagesBefore()[shortageId()].replacement
        && shortageAfter().flaggedAt == shortagesBefore()[shortageId()].flaggedAt
        && shortageAfter().decidedAt == request.time
        && request.resource.data.openShortages
            == resource.data.openShortages - 1;

      allow delete: if false;
    }

    // A customer's rating of one completed order. The document id is the
    // order id, so an order is rated once. Reviews are immutable: no update
    // and no delete from the client.
    match /reviews/{orderId} {
      function order() {
        return get(/databases/$(database)/documents/orders/$(orderId)).data;
      }

      function validScore(value) {
        return value is int && value >= 1 && value <= 5;
      }

      // Owner reads their review, the admin reads all (Reviews tab).
      // `resource == null` lets the
      // customer check whether they have rated yet (reading a document that
      // does not exist would otherwise be denied, because resource.data is
      // null).
      allow read: if (request.auth != null
          && (resource == null
              || resource.data.customerId == request.auth.uid))
        || isAdmin();

      // Only for the customer's own order, once it is completed, with
      // scores from 1 to 5 and a delivery score exactly for delivery orders.
      allow create: if request.auth != null
        && request.resource.data.customerId == request.auth.uid
        && order().customerId == request.auth.uid
        && order().status == 'completed'
        && request.resource.data.orderNumber == order().number
        && request.resource.data.branchId == order().branchId
        && request.resource.data.keys().hasOnly(
            ['orderNumber', 'branchId', 'customerId', 'customerName',
             'shoppingScore', 'productScore', 'deliveryScore', 'driverId',
             'driverName', 'comment', 'createdAt'])
        && request.resource.data.keys().hasAll(
            ['orderNumber', 'branchId', 'customerId', 'customerName',
             'shoppingScore', 'productScore', 'createdAt'])
        && request.resource.data.get('driverId', null)
            == order().get('driverId', null)
        && request.resource.data.get('driverName', null)
            == order().get('driverName', null)
        && validScore(request.resource.data.shoppingScore)
        && validScore(request.resource.data.productScore)
        && (('deliveryScore' in request.resource.data)
            == order().isDelivery)
        && (!('deliveryScore' in request.resource.data)
            || validScore(request.resource.data.deliveryScore))
        && (!('comment' in request.resource.data)
            || (request.resource.data.comment is string
                && request.resource.data.comment.size() <= 500))
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    // Where each delivery driver is now, for the Dispatch map. Only the
    // admin reads them; only a Delivery Driver writes, and only their own
    // document, with a real position and the server time. Nobody deletes.
    match /driverLocations/{driverId} {
      allow read: if isAdmin();
      allow create, update: if isDriver()
        && request.auth.uid == driverId
        && request.resource.data.keys().hasOnly(['position', 'updatedAt'])
        && request.resource.data.position is latlng
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Monotonic order-number counter. The Function alone increments it;
    // signed-in users may read it for older screens.
    match /counters/{name} {
      allow read: if isSignedIn();
      // `resource` is null when the counter does not exist yet (first bump),
      // so check for null before reading resource.data; `!resource.exists`
      // would throw a null error and deny the create.
      allow write: if false;
    }
  }
}
