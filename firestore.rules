rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // True if the signed-in user's profile says they are the HQ admin.
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
            .data.role == 'storeAdmin';
    }

    // User profiles. The document id is the Firebase Authentication uid.
    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      // Users read their own profile. The admin reads all (Staff tab).
      allow read: if isOwner() || isAdmin();

      // Public sign-up can only create customers, and only with these fields.
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'role', 'createdAt'])
        && request.resource.data.role == 'customer'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;

      // The admin creates Store Worker profiles from the Staff tab.
      allow create: if isAdmin()
        && request.resource.data.role == 'storeWorker'
        && request.resource.data.workerRole in ['packingStaff', 'deliveryDriver']
        && request.resource.data.isActive == true;

      // Users can edit their details, but never their own role, email,
      // creation time, branch or active flag.
      allow update: if isOwner()
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role', 'email', 'createdAt', 'workerRole', 'branchId',
                     'isActive', 'joinedAt']);

      // The admin edits workers (details, role, branch, active), but not
      // their login email, and cannot turn them into another kind of user.
      allow update: if isAdmin()
        && resource.data.role == 'storeWorker'
        && request.resource.data.role == 'storeWorker'
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['email', 'createdAt', 'joinedAt']);

      allow delete: if false;
    }

    // Store branches. Every signed-in user can see them (customers choose
    // a branch, workers see theirs). Only the admin adds or edits them.
    // Branches are never deleted; they are closed instead.
    match /branches/{branchId} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin();
      allow delete: if false;
    }
  }
}
