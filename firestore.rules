rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // True if the signed-in user's profile says they are the HQ admin.
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
            .data.role == 'storeAdmin';
    }

    // User profiles. The document id is the Firebase Authentication uid.
    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      // Users read their own profile. The admin reads all (Staff tab).
      allow read: if isOwner() || isAdmin();

      // Public sign-up can only create customers, and only with these fields.
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'role', 'createdAt'])
        && request.resource.data.role == 'customer'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;

      // The admin creates Store Worker profiles from the Staff tab.
      allow create: if isAdmin()
        && request.resource.data.role == 'storeWorker'
        && request.resource.data.workerRole in ['packingStaff', 'deliveryDriver']
        && request.resource.data.isActive == true;

      // Users can edit their details, but never their own role, email,
      // creation time, branch or active flag.
      allow update: if isOwner()
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role', 'email', 'createdAt', 'workerRole', 'branchId',
                     'isActive', 'joinedAt']);

      // The admin edits workers (details, role, branch, active), but not
      // their login email, and cannot turn them into another kind of user.
      allow update: if isAdmin()
        && resource.data.role == 'storeWorker'
        && request.resource.data.role == 'storeWorker'
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['email', 'createdAt', 'joinedAt']);

      allow delete: if false;

      // A customer's saved delivery addresses. Private to the owner: nobody
      // else, not even the admin, reads or writes them.
      match /addresses/{addressId} {
        allow read, write: if isOwner();
      }

      // A customer's saved cart: a single document, private to the owner.
      // Holds only product ids and quantities; prices and stock are read
      // from the catalogue when the cart is loaded.
      match /cart/{docId} {
        allow read, delete: if isOwner();
        allow create, update: if isOwner()
          && docId == 'current'
          && request.resource.data.keys()
              .hasOnly(['lines', 'fulfilment', 'promoCode', 'updatedAt'])
          && request.resource.data.keys()
              .hasAll(['lines', 'fulfilment', 'updatedAt'])
          && request.resource.data.lines is list
          && request.resource.data.lines.size() <= 100
          && request.resource.data.fulfilment in ['delivery', 'pickup']
          && request.resource.data.updatedAt == request.time;
      }
    }

    // Catalogue read access for the customer app.
    //
    // Products and categories are shared across branches; a branch's
    // inventory (price, stock) lives under branches/{branchId}/inventory.
    // Any signed-in user may read the catalogue. Only the admin writes it
    // (the Inventory tab), with the shape checked here; nothing is ever
    // deleted from the client (hide a product at a branch instead).
    function isSignedIn() {
      return request.auth != null;
    }

    // A product document as the Inventory tab saves it.
    function validProduct(data) {
      return data.keys().hasOnly(
          ['name', 'brand', 'categoryId', 'packSize', 'description',
           'imageUrls', 'lowStockLevel'])
        && data.keys().hasAll(['name', 'categoryId'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.categoryId is string
        && (!('imageUrls' in data)
            || (data.imageUrls is list && data.imageUrls.size() <= 5))
        && (!('lowStockLevel' in data)
            || (data.lowStockLevel is int && data.lowStockLevel >= 0));
    }

    match /products/{productId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && validProduct(request.resource.data);
      allow delete: if false;
    }

    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'sortOrder'])
        && request.resource.data.keys().hasAll(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && (!('sortOrder' in request.resource.data)
            || request.resource.data.sortOrder is int);
      allow delete: if false;
    }

    // Store branches. Every signed-in user can see them (customers choose
    // a branch, workers see theirs). Only the admin adds or edits them.
    // Branches are never deleted; they are closed instead.
    match /branches/{branchId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if false;

      // Price and stock of a product at this branch; the document id is the
      // product id. Only the admin writes it.
      match /inventory/{productId} {
        allow read: if isSignedIn();
        allow create, update: if isAdmin()
          && request.resource.data.keys().hasOnly(['price', 'stock', 'isHidden'])
          && request.resource.data.keys().hasAll(['price', 'stock', 'isHidden'])
          && request.resource.data.price is number
          && request.resource.data.price >= 0
          && request.resource.data.stock is int
          && request.resource.data.stock >= 0
          && request.resource.data.isHidden is bool;
        allow delete: if false;
      }
    }

    // Customer orders (the shared order contract). The customer app writes
    // an order at checkout and reads its own orders for tracking; the Store
    // Worker and Store Admin apps read them to pack and oversee.
    //
    // A signed-in staff member (not a customer) can read any order. The id
    // of the staff role check is kept here rather than inferred, so a
    // customer can never read another customer's order.
    function isStaff() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
            .data.role in ['storeAdmin', 'storeWorker'];
    }

    match /orders/{orderId} {
      function isOrderOwner() {
        return request.auth != null
          && resource.data.customerId == request.auth.uid;
      }

      // Owner reads their own order; staff read any order.
      allow read: if isOrderOwner() || isStaff();

      // A customer creates their own order. The order must belong to them,
      // start in a pending state, and carry the required fields, so a
      // client cannot forge an order into packing or onto another account.
      allow create: if request.auth != null
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasAll(
            ['number', 'customerId', 'branchId', 'items', 'total', 'status',
             'placedAt'])
        && request.resource.data.placedAt == request.time;

      // Staff advance an order's status (pack, ready, deliver, complete).
      allow update: if isStaff();

      // A customer may cancel their own order, but only while it is still
      // pending (nobody has started packing it), and nothing else about the
      // order may change.
      allow update: if isOrderOwner()
        && resource.data.status == 'pending'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'statusSince'])
        && request.resource.data.statusSince == request.time;

      allow delete: if false;
    }

    // A customer's rating of one completed order. The document id is the
    // order id, so an order is rated once. Reviews are immutable: no update
    // and no delete from the client.
    match /reviews/{orderId} {
      function order() {
        return get(/databases/$(database)/documents/orders/$(orderId)).data;
      }

      function validScore(value) {
        return value is int && value >= 1 && value <= 5;
      }

      // Owner reads their review, staff read all. `resource == null` lets the
      // customer check whether they have rated yet (reading a document that
      // does not exist would otherwise be denied, because resource.data is
      // null).
      allow read: if (request.auth != null
          && (resource == null
              || resource.data.customerId == request.auth.uid))
        || isStaff();

      // Only for the customer's own order, once it is completed, with
      // scores from 1 to 5 and a delivery score exactly for delivery orders.
      allow create: if request.auth != null
        && request.resource.data.customerId == request.auth.uid
        && order().customerId == request.auth.uid
        && order().status == 'completed'
        && request.resource.data.orderNumber == order().number
        && request.resource.data.branchId == order().branchId
        && request.resource.data.keys().hasOnly(
            ['orderNumber', 'branchId', 'customerId', 'customerName',
             'shoppingScore', 'productScore', 'deliveryScore', 'comment',
             'createdAt'])
        && request.resource.data.keys().hasAll(
            ['orderNumber', 'branchId', 'customerId', 'customerName',
             'shoppingScore', 'productScore', 'createdAt'])
        && validScore(request.resource.data.shoppingScore)
        && validScore(request.resource.data.productScore)
        && (('deliveryScore' in request.resource.data)
            == order().isDelivery)
        && (!('deliveryScore' in request.resource.data)
            || validScore(request.resource.data.deliveryScore))
        && (!('comment' in request.resource.data)
            || (request.resource.data.comment is string
                && request.resource.data.comment.size() <= 500))
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    // Monotonic counters, e.g. the order-number sequence. Any signed-in
    // user may read and bump a counter (checkout reserves the next order
    // number here, since a customer cannot scan all orders). The value only
    // ever moves forward; order ownership is still enforced on orders/.
    match /counters/{name} {
      allow read: if isSignedIn();
      // `resource` is null when the counter does not exist yet (first bump),
      // so check for null before reading resource.data; `!resource.exists`
      // would throw a null error and deny the create.
      allow write: if isSignedIn()
        && request.resource.data.keys().hasOnly(['value'])
        && request.resource.data.value is int
        && (resource == null
            || request.resource.data.value > resource.data.value);
    }
  }
}
