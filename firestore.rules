rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles. The document id is the Firebase Authentication uid.
    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      // Users can only read their own profile.
      allow read: if isOwner();

      // Public sign-up can only create customers, and only with these fields.
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'role', 'createdAt'])
        && request.resource.data.role == 'customer'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;

      // Users can edit their details, but never their own role, email or
      // creation time.
      allow update: if isOwner()
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role', 'email', 'createdAt']);

      allow delete: if false;
    }
  }
}
