{
  "name": "grocerly-firestore-rules-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Firestore Security Rules tests for Grocerly, run against the Firebase Emulator Suite.",
  "type": "module",
  "scripts": {
    "test": "firebase emulators:exec --only firestore --project mae-assignment-grocerly 'vitest run'",
    "test:watch": "firebase emulators:exec --only firestore --project mae-assignment-grocerly 'vitest'"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "^12.0.0",
    "vitest": "^3.0.0"
  }
}
