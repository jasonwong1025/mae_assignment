{
  "name": "grocerly-firestore-rules-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Firestore and Storage Security Rules tests for Grocerly, run against the Firebase Emulator Suite.",
  "type": "module",
  "scripts": {
    "test": "firebase emulators:exec --only firestore,storage --project mae-assignment-grocerly 'vitest run'",
    "test:watch": "firebase emulators:exec --only firestore,storage --project mae-assignment-grocerly 'vitest'",
    "seed": "node seed.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "^12.0.0",
    "firebase-admin": "^13.0.0",
    "firebase-tools": "^15.0.0",
    "vitest": "^3.0.0"
  }
}
